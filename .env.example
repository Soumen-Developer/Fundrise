NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL / Render Postgres / Docker Compose)
# On Render: Link PostgreSQL service to set DATABASE_URL automatically
DATABASE_URL=postgresql://fundrise:fundrise_pass@localhost:5432/fundrise

# Authentication
JWT_SECRET=fundrise_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Payment Gateway (Razorpay test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Automated Database Seeding (true to seed demo accounts and campaigns)
AUTO_SEED=true

