NODE_ENV=production
PORT=5000
AUTO_SEED=true
JWT_SECRET=fundrise_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Optional: Remote PostgreSQL connection string (e.g. from Render PostgreSQL)
# If omitted or left empty, the application automatically uses the internal SQLite engine.
DATABASE_URL=

