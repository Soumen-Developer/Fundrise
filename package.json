{
  "name": "fundrise-monorepo",
  "version": "1.0.0",
  "description": "FundRise - Modern Crowdfunding Platform",
  "scripts": {
    "postinstall": "npm --prefix backend install && npm --prefix frontend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.cjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": ["crowdfunding", "donation", "react", "express", "postgresql"],
  "author": "",
  "license": "ISC"
}
